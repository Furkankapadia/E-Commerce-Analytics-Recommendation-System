# ==========================================
# BI-Predict SMTP Configuration (Optional)
# Copy this file to '.env' and fill in your details to enable real verification emails!
# ==========================================

# SMTP Host details (Defaults to Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your sender email ID (e.g., yourname@gmail.com)
SMTP_EMAIL=your_sender_gmail@gmail.com

# For Gmail, you MUST use a Google App Password (16-digit code).
# Do NOT enter your actual Google account password!
# Generating an App Password takes 30 seconds: https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=abcd efgh ijkl mnop
